  "L13": "\\mathcal{L}_{0^{-}}\\!\\left\\{\\delta\\left(t - 2\\right)\\right\\}\\;=\\;e^{- 2 s}",
  "Z11": "\\mathcal{Z}\\!\\left\\{\\sin{\\left(\\frac{\\pi n}{2} \\right)} u\\left[n\\right]\\right\\}\\;=\\;\\frac{z}{z^{2} + 1}",
