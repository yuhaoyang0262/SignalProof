{
  "C01": "x(t)\\ast h(t)=h(t)\\ast x(t)",
  "C02": "\\bigl[x(t)\\ast h(t)\\bigr]\\ast g(t)=x(t)\\ast\\bigl[h(t)\\ast g(t)\\bigr]",
  "C03": "\\bigl[x(t)+h(t)\\bigr]\\ast g(t)=x(t)\\ast g(t)+h(t)\\ast g(t)",
  "C04": "\\bigl[a\\,x(t)\\bigr]\\ast h(t)=a\\bigl[x(t)\\ast h(t)\\bigr]",
  "C05": "x(t)\\ast\\delta(t)=x(t)",
  "C06": "x(t)\\ast\\delta(t-a)=x(t-a)",
  "C07": "x(t)\\ast 0=0",
  "C08": "\\frac{\\mathrm d}{\\mathrm dt}\\bigl[x(t)\\ast h(t)\\bigr]=\\frac{\\mathrm dx(t)}{\\mathrm dt}\\ast h(t)",
  "F01": "\\mathcal{F}\\!\\left\\{a\\,x(t)+b\\,h(t)\\right\\}=a\\,X(\\omega)+b\\,H(\\omega)",
  "F02": "\\mathcal{F}\\!\\left\\{x(t-a)\\right\\}=e^{-\\mathrm j\\omega a}X(\\omega)",
  "F03": "\\mathcal{F}\\!\\left\\{e^{\\mathrm jbt}x(t)\\right\\}=X(\\omega-b)",
  "F04": "\\mathcal{F}\\!\\left\\{x(at)\\right\\}=\\frac{1}{|a|}X\\!\\left(\\frac{\\omega}{a}\\right),\\quad a\\in\\mathbb{R}\\setminus\\{0\\}",
  "F05": "\\mathcal{F}\\!\\left\\{\\overline{x(t)}\\right\\}=\\overline{X(-\\omega)}",
  "F06": "\\mathcal{F}\\!\\left\\{\\frac{\\mathrm d^{k}x(t)}{\\mathrm dt^{k}}\\right\\}=(\\mathrm j\\omega)^kX(\\omega)",
  "F07": "\\mathcal{F}\\!\\left\\{t\\,x(t)\\right\\}=\\mathrm j\\frac{\\mathrm dX(\\omega)}{\\mathrm d\\omega}",
  "F08": "\\mathcal{F}\\!\\left\\{x(t)\\ast h(t)\\right\\}=X(\\omega)H(\\omega)",
  "F09": "\\mathcal{F}\\!\\left\\{x(t)h(t)\\right\\}=\\frac{1}{2\\pi}\\bigl[X(\\omega)\\ast H(\\omega)\\bigr]",
  "F10": "\\mathcal{F}\\!\\left\\{\\delta(t)\\right\\}=1",
  "F11": "\\mathcal{F}\\!\\left\\{e^{-at}u(t)\\right\\}=\\frac{1}{a+\\mathrm j\\omega},\\quad a>0",
  "F12": "\\mathcal{F}\\!\\left\\{e^{-at^2}\\right\\}=\\sqrt{\\frac{\\pi}{a}}\\,e^{-\\omega^2/(4a)},\\quad a>0",
  "L01": "\\mathcal{L}_{0^-}\\!\\left\\{a\\,x(t)+b\\,h(t)\\right\\}=a\\,X(s)+b\\,H(s)",
  "L02": "\\mathcal{L}_{0^-}\\!\\left\\{x^{\\prime}(t)\\right\\}=sX(s)-x(0^-)",
  "L03": "\\mathcal{L}_{0^-}\\!\\left\\{x^{\\prime\\prime}(t)\\right\\}=s^2X(s)-s\\,x(0^-)-x^{\\prime}(0^-)",
  "L04": "\\mathcal{L}_{0^-}\\!\\left\\{t\\,x(t)\\right\\}=-\\frac{\\mathrm dX(s)}{\\mathrm ds}",
  "L05": "\\mathcal{L}_{0^-}\\!\\left\\{e^{at}x(t)\\right\\}=X(s-a)",
  "L06": "\\mathcal{L}_{0^-}\\!\\left\\{x(t-a)u(t-a)\\right\\}=e^{-as}X(s),\\quad a>0",
  "L07": "\\mathcal{L}_{0^-}\\!\\left\\{x(t)\\ast h(t)\\right\\}=X(s)H(s)",
  "L08": "\\mathcal{L}_{0^-}\\!\\left\\{\\int_0^t x(\\tau)\\,\\mathrm d\\tau\\right\\}=\\frac{X(s)}{s}",
  "L09": "\\begin{gathered}\\mathcal{L}_{0^-}\\!\\left\\{u(t)\\right\\}=\\frac{1}{s}\\\\\\operatorname{ROC}:\\ \\operatorname{Re}(s)>0\\end{gathered}",
  "L10": "\\begin{gathered}\\mathcal{L}_{0^-}\\!\\left\\{e^{-at}u(t)\\right\\}=\\frac{1}{s+a}\\\\\\operatorname{ROC}:\\ \\operatorname{Re}(s)>-a\\end{gathered}",
  "Z01": "\\mathcal{Z}\\!\\left\\{a\\,x[n]+b\\,h[n]\\right\\}=a\\,X(z)+b\\,H(z)",
  "Z02": "\\mathcal{Z}\\!\\left\\{x[n-k]\\right\\}=z^{-k}X(z),\\quad k\\in\\mathbb{Z}",
  "Z03": "\\mathcal{Z}\\!\\left\\{x[-n]\\right\\}=X\\!\\left(\\frac{1}{z}\\right)",
  "Z04": "\\mathcal{Z}\\!\\left\\{a^n x[n]\\right\\}=X\\!\\left(\\frac{z}{a}\\right),\\quad a\\ne0",
  "Z05": "\\mathcal{Z}\\!\\left\\{n\\,x[n]\\right\\}=-z\\frac{\\mathrm dX(z)}{\\mathrm dz}",
  "Z06": "\\mathcal{Z}\\!\\left\\{x[n]\\ast h[n]\\right\\}=X(z)H(z)",
  "Z07": "\\mathcal{Z}\\!\\left\\{\\overline{x[n]}\\right\\}=\\overline{X\\!\\left(\\overline{z}\\right)}",
  "Z08": "\\begin{gathered}\\mathcal{Z}\\!\\left\\{\\delta[n]\\right\\}=1\\\\\\operatorname{ROC}:\\ \\mathbb{C}\\cup\\{\\infty\\}\\end{gathered}",
  "Z09": "\\begin{gathered}\\mathcal{Z}\\!\\left\\{a^n u[n]\\right\\}=\\frac{z}{z-a}\\\\\\operatorname{ROC}:\\ |z|>|a|\\end{gathered}",
  "Z10": "\\begin{gathered}\\mathcal{Z}\\!\\left\\{-a^n u[-n-1]\\right\\}=\\frac{z}{z-a}\\\\\\operatorname{ROC}:\\ |z|<|a|,\\quad a\\ne0\\end{gathered}",
  "F00": "\\mathcal{F}\\!\\left\\{x(t)\\right\\}=X(\\omega)",
  "L00": "\\mathcal{L}_{0^-}\\!\\left\\{x(t)\\right\\}=X(s)",
