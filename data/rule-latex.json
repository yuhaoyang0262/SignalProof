  "F13": "\\mathcal{F}_{t\\to \\omega}\\!\\left\\{\\sin{\\left(2 t \\right)}\\right\\}\\;=\\;\\frac{\\pi \\left(\\delta\\left(\\omega - 2\\right) - \\delta\\left(\\omega + 2\\right)\\right)}{j}",
  "F14": "\\mathcal{F}_{t\\to \\omega}\\!\\left\\{\\cos{\\left(2 t \\right)}\\right\\}\\;=\\;\\pi \\left(\\delta\\left(\\omega - 2\\right) + \\delta\\left(\\omega + 2\\right)\\right)",
  "F15": "\\mathcal{F}_{t\\to \\omega}\\!\\left\\{1\\right\\}\\;=\\;2 \\pi \\delta\\left(\\omega\\right)",
  "L11": "\\mathcal{L}_{0^{-}}\\!\\left\\{\\sin{\\left(2 t \\right)} u\\left(t\\right)\\right\\}\\;=\\;\\frac{2}{s^{2} + 4}",
